# -*- mode: ruby -*-
# vi: set ft=ruby :

N = 3
BOX = 'rockylinux/8'
BoxV = '9.0.0'

Vagrant.configure("2") do |config|
    ####################
    #    All in One    #
    ####################
    (1..N).each do |i|
      config.vm.define "openstack" do |cfg|
        cfg.vm.box = BOX
        #cfg.vm.box_url = "" 
        cfg.vm.box_version = BoxV     
        cfg.vm.provider "virtualbox" do |vb|
          vb.name = "controller-#{i}"
          vb.cpus = 4 
          vb.memory = 8192
          vb.customize ["modifyvm", :id, "--groups", "/openstack-allinone", "--nested-hw-virt", "on"] 
        end
     
        cfg.vm.host_name = "controller-#{i}"
        cfg.vm.network "private_network", ip: "192.168.1.2#{i}"
        cfg.vm.network "forwarded_port", guest: 22, host: "2002#{i}", auto_correct: true, id: "ssh"
        cfg.vm.network "public_network", type: "dhcp"
        cfg.vm.synced_folder "../data", "/vagrant", disabled: true
        #cfg.vm.provision "shell", path: "init.sh", args: BOX
      end
    end
end



